{
  "name": "lossline-backend",
  "version": "1.0.0",
  "description": "LOSSLine — operational overload detection & investigation agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "tsx watch src/index.ts & tsx watch src/worker.ts",
    "build": "tsc && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "replay:overload": "tsx scripts/replay-overload.ts",
    "replay:fresh": "tsx scripts/replay-overload.ts --reset --wipe",
    "replay:reset": "tsx scripts/replay-reset.ts",
    "replay:reset:wipe": "tsx scripts/replay-reset.ts --wipe",
    "smoke:investigate": "tsx scripts/smoke-investigate.ts",
    "smoke:approve": "tsx scripts/smoke-approve.ts",
    "replay:meghana": "tsx scripts/replay-meghana.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
